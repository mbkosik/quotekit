---
const { user } = Astro.locals;
---

<div class="flex items-center justify-between border-b border-white/10 bg-white/5 px-6 py-3 text-sm text-white/80">
  <a href="/new" class="text-lg font-semibold text-white">QuoteKit</a>
  {
    user ? (
      <div class="flex items-center gap-4">
        <nav aria-label="Nawigacja główna">
          <div class="flex items-center gap-4">
            <a href="/quotes" class="text-white/60 transition-colors hover:text-white">
              Wyceny
            </a>
            <a href="/settings" class="text-white/60 transition-colors hover:text-white">
              Ustawienia
            </a>
          </div>
        </nav>
        <span class="text-blue-100/70">{user.email}</span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign in
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign up
        </a>
      </div>
    )
  }
</div>
