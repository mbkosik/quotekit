---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { QuoteEditor } from "@/components/quotes/QuoteEditor";
import { createClient } from "@/lib/supabase";
import type { Quote } from "@/types";
import { z } from "zod";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/signin");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return new Response(null, { status: 503 });

const parsedId = z.uuid().safeParse(Astro.params.id);
if (!parsedId.success) return new Response(null, { status: 400 });
const id = parsedId.data;

const result = (await supabase.from("quotes").select("*").eq("id", id).eq("user_id", user.id).single()) as
  | { data: Quote; error: null }
  | { data: null; error: Error };

if (result.error) return new Response(null, { status: 404 });

const quote = result.data;
---

<Layout title={`${quote.title} — QuoteKit`}>
  <div class="flex min-h-screen flex-col bg-gray-950 text-white">
    <Topbar />
    <main class="flex flex-1 flex-col items-center px-4 py-10">
      <QuoteEditor quote={quote} client:load />
    </main>
  </div>
</Layout>
