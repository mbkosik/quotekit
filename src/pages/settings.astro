---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { UserContextForm } from "@/components/settings/UserContextForm";
import type { PostgrestError } from "@supabase/supabase-js";
import { createClient } from "@/lib/supabase";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/signin");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return new Response("Serwis niedostępny", { status: 503 });

const { data, error } = (await supabase
  .from("user_settings")
  .select("prompt_context")
  .eq("user_id", user.id)
  .maybeSingle()) as { data: { prompt_context: string } | null; error: PostgrestError | null };

if (error) return new Response("Błąd serwera", { status: 503 });

const promptContext = data?.prompt_context ?? "";
---

<Layout title="Ustawienia — QuoteKit">
  <div class="flex min-h-screen flex-col bg-gray-950 text-white">
    <Topbar />
    <main class="flex flex-1 flex-col items-center px-4 py-10">
      <div class="w-full max-w-3xl">
        <h1 class="mb-8 text-2xl font-bold">Ustawienia</h1>
        <UserContextForm context={promptContext} client:load />
      </div>
    </main>
  </div>
</Layout>
